APP_NAME=Aisi
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ka
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ka_GE

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# App storage/display timezone is Asia/Tbilisi (see docs/02 section 5.3); the
# framework's own app.timezone stays UTC so DB timestamps remain UTC.
#
# Local/test default is PostgreSQL. Production uses MySQL/Percona instead —
# see docs/decisions/0001-stack-and-versions.md ("განახლება 2026-09-10") for
# why, and set DB_CONNECTION=mysql + DB_PORT=3306 there.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=aisi_local
DB_USERNAME=postgres
DB_PASSWORD=change_me

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.test"
MAIL_FROM_NAME="${APP_NAME}"

# Public bucket (media, published content) and private bucket (student files,
# documents) are separate — private files are never served through the CDN.
AWS_ACCESS_KEY_ID=change_me
AWS_SECRET_ACCESS_KEY=change_me
AWS_DEFAULT_REGION=change_me
AWS_BUCKET_PUBLIC=change_me
AWS_BUCKET_PRIVATE=change_me
AWS_ENDPOINT=change_me
AWS_USE_PATH_STYLE_ENDPOINT=false

# Payment provider adapter — sandbox only until a real merchant contract exists
PAYMENT_PROVIDER=sandbox
PAYMENT_PROVIDER_KEY=change_me
PAYMENT_PROVIDER_SECRET=change_me
PAYMENT_WEBHOOK_SECRET=change_me

# Finance sandbox (config/finance.php). Keep disabled wherever real families
# can reach the finance module. Secret defaults to a value derived from APP_KEY.
FINANCE_SANDBOX_ENABLED=false
FINANCE_SANDBOX_WEBHOOK_SECRET=

# Health record (config/health.php). Retention stays empty until the legal
# retention period is confirmed.
HEALTH_EMERGENCY_ACCESS_MINUTES=120
HEALTH_DOWNLOAD_LINK_MINUTES=5
HEALTH_RETENTION_YEARS=

VITE_APP_NAME="${APP_NAME}"

# Private upload scanning (config/uploads.php). Set false once an AV engine
# is installed or real families upload, to refuse unscanned files.
UPLOADS_ALLOW_UNSCANNED=true

# Tenant admins must enrol 2FA before using the portal (CLAUDE.md #4).
ADMIN_MFA_REQUIRED=true
PRIVILEGED_REAUTH=true

# Antivirus: null (files marked skipped) or clamd
UPLOADS_SCANNER=null
CLAMD_ADDRESS=tcp://127.0.0.1:3310
CLAMD_TIMEOUT=30
SECURITY_CSP=report-only
