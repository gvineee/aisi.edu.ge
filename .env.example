APP_NAME="Aisi"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE="Asia/Tbilisi"
APP_URL=http://localhost

APP_LOCALE=ka
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=aisi_local
DB_USERNAME=change_me
DB_PASSWORD=change_me

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true

CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=change_me
MAIL_PORT=2525
MAIL_USERNAME=change_me
MAIL_PASSWORD=change_me
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@example.test"
MAIL_FROM_NAME="${APP_NAME}"

FILESYSTEM_DISK=local

# Public bucket (media, published content) — separate from private bucket below
AWS_ACCESS_KEY_ID=change_me
AWS_SECRET_ACCESS_KEY=change_me
AWS_DEFAULT_REGION=change_me
AWS_BUCKET_PUBLIC=change_me
AWS_ENDPOINT=change_me
AWS_USE_PATH_STYLE_ENDPOINT=false

# Private bucket (student files, documents) — never expose via CDN
AWS_BUCKET_PRIVATE=change_me

# Payment provider adapter — sandbox only until a real merchant contract exists
PAYMENT_PROVIDER=sandbox
PAYMENT_PROVIDER_KEY=change_me
PAYMENT_PROVIDER_SECRET=change_me
PAYMENT_WEBHOOK_SECRET=change_me

VITE_APP_NAME="${APP_NAME}"
